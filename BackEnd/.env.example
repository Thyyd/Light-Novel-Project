# ============================
# Base de données (PostgreSQL / Prisma)
# Pour les tests, voir .env.test (même variable DATABASE_URL, valeurs différentes)
# ============================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lightverse?schema=public"

# ============================
# Serveur Express
# ============================
PORT=3000

# ============================
# Firebase Admin SDK (authentification)
# À récupérer depuis Firebase Console > Paramètres du projet > Comptes de service
# ============================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ============================
# Cloudinary (stockage d'images)
# À récupérer depuis le Dashboard Cloudinary
# ============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================
# Google Books API (bonus)
# ============================
GOOGLE_BOOKS_API_KEY=
