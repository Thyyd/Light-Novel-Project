# ============================
# URL de l'API backend
# ============================
VITE_API_URL=http://localhost:3000/api

# ============================
# Firebase (configuration client)
# À récupérer depuis Firebase Console > Paramètres du projet > Général > Vos applications
# Ces valeurs sont publiques par nature (utilisées côté client), contrairement aux clés Admin SDK du backend
# ============================
VITE_FIREBASE_API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
